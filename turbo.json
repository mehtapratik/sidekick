{
   "$schema": "https://turbo.build/schema.json",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**", ".next/**", "*.tsbuildinfo"],
         "env": [
            "NEXT_PUBLIC_SUPABASE_URL",
            "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
            "SUPABASE_SECRET_KEY",
            "DATABASE_URL",
            "ANTHROPIC_API_KEY",
            "OPENAI_API_KEY",
            "STRIPE_SECRET_KEY",
            "STRIPE_WEBHOOK_SECRET",
            "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
            "NEXT_PUBLIC_APP_URL"
         ]
      },
      "dev": {
         "cache": false,
         "persistent": true
      },
      "lint": {
         "dependsOn": ["@sidekick/eslint-plugin-sidekick#build", "^lint"]
      },
      "typecheck": {
         "dependsOn": ["^typecheck"]
      },
      "db:migrate": {
         "cache": false,
         "dependsOn": ["^db:migrate"],
         "passThroughEnv": ["DATABASE_DIRECT_URL"]
      },
      "db:generate": {
         "cache": false,
         "passThroughEnv": ["DATABASE_DIRECT_URL"]
      },
      "test": {},
      "test:integration": {
         "cache": false,
         "passThroughEnv": [
            "DATABASE_URL",
            "TEST_AUTH_DATABASE_URL",
            "TEST_ADMIN_DATABASE_URL"
         ]
      }
   }
}
