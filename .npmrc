# ── Peer dependencies ────────────────────────────────────────────────────────
# Fail loudly at install time when a package's peer dependencies are missing.
# Prevents silent runtime failures caused by mismatched or absent peer deps.
strict-peer-dependencies=true

# ── Dependency hygiene ────────────────────────────────────────────────────────
# Save exact versions by default — no surprise patch upgrades between installs.
save-exact=true
