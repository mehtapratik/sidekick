      "server-only": "^0.0.1"
   },
   "devDependencies": {
      "@sidekick/test-utils": "workspace:*",
      "@types/node": "^24.19.2",
      "drizzle-kit": "^0.31.11",
      "next": "^16.4.3",
      "vitest": "^5.0.5"
   },
   "peerDependencies": {
      "next": ">=16.4.3"
   }
}
