{
  "name": "arkive-light",
  "type": "light",
  "colors": {
    "editor.background": "#F6F4F0",
    "editor.foreground": "#0E0E0E"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6E6B65",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "string.unquoted",
        "constant.character",
        "punctuation.definition.string",
        "meta.attribute.string"
      ],
      "settings": {
        "foreground": "#2F5D86"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8A1F43"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.other.attribute-name",
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#5B4A9E"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "support.variable",
        "meta.definition.variable",
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#0E0E0E"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8A1F43",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0E0E0E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#0E0E0E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2F5D86"
      }
    }
  ]
}
