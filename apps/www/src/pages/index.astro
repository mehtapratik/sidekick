---
import EntryPage from '../components/EntryPage.astro';
import Layout from '../layouts/Layout.astro';
import { getListedEntries } from '../lib/entries';

const [newest] = await getListedEntries();
---

{
   newest ? (
      <EntryPage entry={newest} home />
   ) : (
      <Layout title="Arkive">
         <p>Nothing is published yet.</p>
      </Layout>
   )
}
