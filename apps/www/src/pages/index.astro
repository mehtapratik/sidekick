---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts, getHeroPost, postUrl } from "../lib/entries.ts";
import HeroArt from "../components/HeroArt.astro";
import PostRow from "../components/PostRow.astro";
import {
   loadContentMeta,
   NAV_SECTIONS,
   SECTION_LABELS,
   SECTION_DESCRIPTIONS,
} from "../lib/site.ts";
import { formatDate } from "../lib/reading.ts";

const meta = loadContentMeta();
const heroPost = await getHeroPost();
const allPosts = await getAllPosts();
const latestPosts = allPosts.filter((p) => p.id !== heroPost?.id);
---

<BaseLayout title={meta.site.title ?? "ARKIVE"} description={meta.site.intro}>
   <div class="stage">
      {meta.site.intro && <p class="lede">{meta.site.intro}</p>}
      {
         heroPost && (
            <section class="featured">
               <p class="eyebrow">Featured post</p>
               <HeroArt post={heroPost} width={640} class="featured-hero" />
               <h1 class="featured-title">
                  <a href={postUrl(heroPost)}>{heroPost.data.title}</a>
               </h1>
               {heroPost.data.deck && (
                  <p class="featured-blurb">{heroPost.data.deck}</p>
               )}
               <p class="featured-meta">
                  {SECTION_LABELS[heroPost.data.section]} ·{" "}
                  {formatDate(heroPost.data.created)}
               </p>
            </section>
         )
      }

      {
         latestPosts.length > 0 && (
            <>
               <div class="rule" />
               <p class="section-label">Most recent posts</p>
               {latestPosts.map((post) => (
                  <PostRow post={post} showSection={true} />
               ))}
            </>
         )
      }

      <div class="rule"></div>
      <p class="section-label">Sections</p>
      <div class="cat-grid">
         {
            NAV_SECTIONS.map((section) => (
               <div class="cat-cell">
                  <h3>
                     <a href={`/${section}/`}>{SECTION_LABELS[section]}</a>
                  </h3>
                  <p>{SECTION_DESCRIPTIONS[section]}</p>
               </div>
            ))
         }
         <div class="cat-cell">
            <h3>
               <a href="/index/">Index</a>
            </h3>
            <p>Chronological index of every post, across every section.</p>
         </div>
      </div>
   </div>
</BaseLayout>
