---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import Icon from "../components/Icon.astro";
import { getAllWritings, getHeroPost, writingUrl } from "../lib/entries.ts";
import { loadContentMeta, WRITING_TYPE_LABELS } from "../lib/site.ts";
import docTree from "../lib/doc-tree.json";

const meta = loadContentMeta();
const heroPost = await getHeroPost();
const latest = (await getAllWritings()).slice(0, 4);
---

<BaseLayout title={meta.site.title ?? "ARKIVE"} description={meta.site.intro}>
   <div class="wrap">
      <section class="hero" aria-labelledby="hero-title">
         <div>
            <p class="eyebrow">Project Sidekick · built in the open</p>
            <h1 id="hero-title">Notes, decisions &amp; progress, <em>written as it happens.</em></h1>
            {meta.site.intro && <p class="lead">{meta.site.intro}</p>}
            <div class="cta">
               {
                  heroPost && (
                     <a class="btn btn-primary" href={writingUrl(heroPost)}>
                        Read the kick-off essay
                        <Icon name="arrow-right" />
                     </a>
                  )
               }
               <a class="btn btn-ghost" href="/docs/">Browse the vault</a>
            </div>
         </div>
         {
            heroPost && (
               <article class="feature">
                  <p class="panel-label">Start here</p>
                  <h2 class="f-title">
                     <a href={writingUrl(heroPost)}>{heroPost.data.title}</a>
                  </h2>
                  {heroPost.data.deck && <p class="f-deck">{heroPost.data.deck}</p>}
                  <p class="f-meta">
                     <span>{WRITING_TYPE_LABELS[heroPost.data.type]}</span>
                     <span class="dot" aria-hidden="true">
                        ·
                     </span>
                     <span>{heroPost.data.readingMinutes} min read</span>
                  </p>
               </article>
            )
         }
      </section>

      <section class="sec" aria-labelledby="latest-title">
         <div class="sec-hd">
            <div>
               <h2 id="latest-title">Latest writing</h2>
               <p class="sec-sub">Essays and long-form notes, newest first.</p>
            </div>
            <a class="more" href="/writings/">All writings<Icon name="arrow-right" /></a>
         </div>
         <ol class="rows">
            {
               latest.map((post) => (
                  <PostRow
                     level={3}
                     href={writingUrl(post)}
                     title={post.data.title}
                     kind={WRITING_TYPE_LABELS[post.data.type]}
                     minutes={post.data.readingMinutes}
                     deck={post.data.deck}
                     date={post.data.created}
                     tags={post.data.tags}
                  />
               ))
            }
         </ol>
      </section>

      <section class="sec" aria-labelledby="vault-title">
         <div class="sec-hd">
            <div>
               <h2 id="vault-title">From the vault</h2>
               <p class="sec-sub">
                  Specifications, decisions, and plans behind Sidekick, published straight from my
                  notes.
               </p>
            </div>
            <a class="more" href="/docs/">Open the vault<Icon name="arrow-right" /></a>
         </div>
         <div class="vgrid">
            {
               docTree.map((s) => (
                  <a class="vcard" href={`/docs/${s.slug}/`}>
                     <span class="vcard-n" aria-hidden="true">
                        {s.count}
                     </span>
                     <span class="vcard-b">
                        <span class="vcard-l">
                           {s.label}
                           <span class="sr-only"> — {s.count} documents</span>
                        </span>
                        <span class="vcard-go" aria-hidden="true">
                           <Icon name="arrow-up-right" />
                        </span>
                     </span>
                  </a>
               ))
            }
         </div>
      </section>
   </div>
</BaseLayout>
