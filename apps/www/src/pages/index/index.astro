---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MonthIndex from "../../components/MonthIndex.astro";
import { getChronological } from "../../lib/entries.ts";

const items = await getChronological();
---

<BaseLayout title="Index" description="Everything published, newest first — writings and docs alike.">
   <div class="wrap">
      <div class="phd">
         <div>
            <p class="eyebrow">03 · Index</p>
            <h1>Index</h1>
            <p class="sec-sub">Everything published, newest first.</p>
         </div>
         <p class="count">{items.length} {items.length === 1 ? "entry" : "entries"}</p>
      </div>
      <MonthIndex items={items} />
   </div>
</BaseLayout>
