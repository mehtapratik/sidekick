---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../lib/entries.ts";
import HeroArt from "../../components/HeroArt.astro";
import { SECTION_LABELS } from "../../lib/site.ts";
import { formatDate, formatDateYmd } from "../../lib/reading.ts";

export async function getStaticPaths() {
   const posts = await getAllPosts();
   return posts.map((post) => ({
      params: { section: post.data.section, slug: post.id },
      props: { post },
   }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

const tocHeadings = headings.filter((h) => h.depth === 2 && h.text !== "TL;DR");
const showToc = tocHeadings.length >= 3;

const updated = data.updated ?? data.created;
const ogImage = `/og/${data.section}--${post.id}.png`;
---

<BaseLayout
   title={data.title}
   description={data.deck ?? data.description}
   ogType="article"
   ogImage={ogImage}
   activeSection={data.section}
>
   <div class="stage">
      <HeroArt post={post} width={640} class="article-hero" />

      <p class="article-eyebrow">
         {SECTION_LABELS[data.section]} ·{" "}
         <time datetime={formatDateYmd(updated)}>{formatDate(updated)}</time>
      </p>

      <h1 class="article-title">{data.title}</h1>

      {
         (data.description ?? data.deck) && (
            <p class="article-blurb">{data.description ?? data.deck}</p>
         )
      }

      {
         showToc && (
            <nav class="toc" aria-label="Table of contents">
               <p class="toc__label">Contents</p>
               <ul>
                  {tocHeadings.map((h) => (
                     <li>
                        <a href={`#${h.slug}`}>{h.text}</a>
                     </li>
                  ))}
               </ul>
            </nav>
         )
      }

      <div class="prose">
         <Content />
      </div>
   </div>
</BaseLayout>
