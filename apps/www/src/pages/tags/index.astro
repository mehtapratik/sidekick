---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex, tagUrl } from "../../lib/entries.ts";

const tags = [...(await getTagIndex()).values()].sort((a, b) => a.tag.localeCompare(b.tag));
---

<BaseLayout title="Tags" description="Every tag used across writings and the vault.">
   <div class="wrap">
      <div class="phd">
         <div>
            <p class="eyebrow">Tags</p>
            <h1>Tags</h1>
            <p class="sec-sub">Every tag used across writings and the vault.</p>
         </div>
         <p class="count">{tags.length} tags</p>
      </div>
      <ul class="tag-cloud page-end">
         {
            tags.map(({ tag, items }) => (
               <li>
                  <a class="tag" href={tagUrl(tag)}>
                     #{tag}
                     <span class="tag-n">{items.length}</span>
                  </a>
               </li>
            ))
         }
      </ul>
   </div>
</BaseLayout>
