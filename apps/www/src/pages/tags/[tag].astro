---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MonthIndex from "../../components/MonthIndex.astro";
import { getTagIndex } from "../../lib/entries.ts";

export async function getStaticPaths() {
   const index = await getTagIndex();
   return [...index.entries()].map(([slug, { tag, items }]) => ({
      params: { tag: slug },
      props: { tag, items },
   }));
}

const { tag, items } = Astro.props;
const n = items.length;
---

<BaseLayout title={`#${tag}`} description={`Everything tagged #${tag}.`}>
   <div class="wrap">
      <div class="phd">
         <div>
            <p class="eyebrow"><a href="/tags/">Tags</a></p>
            <h1>#{tag}</h1>
            <p class="sec-sub">Writings and vault documents tagged #{tag}, newest first.</p>
         </div>
         <p class="count">{n} {n === 1 ? "entry" : "entries"}</p>
      </div>
      <MonthIndex items={items} />
   </div>
</BaseLayout>
