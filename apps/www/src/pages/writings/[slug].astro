---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Article from "../../components/Article.astro";
import { getAllWritings, writingUrl } from "../../lib/entries.ts";
import { WRITINGS_MOTIF, WRITING_TYPE_LABELS } from "../../lib/site.ts";
import { formatDate } from "../../lib/reading.ts";

export async function getStaticPaths() {
   const posts = await getAllWritings(); // newest first
   return posts.map((post, i) => ({
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
   }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const updated = data.updated ?? data.created;
const deck = data.deck || data.description || undefined;
---

<BaseLayout
   title={data.title}
   description={deck}
   ogType="article"
   ogImage={`/og/writings--${post.id}.png`}
>
   <Article
      crumbs={[{ label: "Writings", href: "/writings/" }, { label: data.title }]}
      kind={WRITING_TYPE_LABELS[data.type]}
      kickerExtra={[
         { text: formatDate(data.created), date: data.created },
         { text: `${data.readingMinutes} min read` },
      ]}
      title={data.title}
      deck={deck}
      meta={[
         { label: "Author", text: data.author },
         { label: "Published", date: data.created },
         ...(updated.getTime() !== data.created.getTime()
            ? [{ label: "Updated", date: updated }]
            : []),
         { label: "Version", text: data.version ?? "1.0.0" },
         ...(data.audience ? [{ label: "Audience", text: data.audience }] : []),
         { label: "License", text: data.license ?? "CC BY-NC 4.0" },
      ]}
      headings={headings}
      tags={data.tags}
      band={{ motif: WRITINGS_MOTIF, seed: data.seed ?? post.id }}
      searchMeta={formatDate(data.created)}
      neighbours={{
         label: "More writing",
         prev: older && { href: writingUrl(older), title: older.data.title, label: "Older" },
         next: newer && { href: writingUrl(newer), title: newer.data.title, label: "Newer" },
      }}
   >
      <Content />
   </Article>
</BaseLayout>
