---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsShell from "../../components/DocsShell.astro";
import DocList from "../../components/DocList.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Article from "../../components/Article.astro";
import {
   getAllDocs,
   getDocChildren,
   getDocNeighbours,
   getFolderLeafCounts,
   buildBreadcrumb,
   getLinkedFrom,
   docUrl,
} from "../../lib/entries.ts";
import {
   loadContentMeta,
   sectionLabel,
   KIND_LABELS,
   KIND_TO_MOTIF,
   STATUS_LABELS,
} from "../../lib/site.ts";
import linkManifest from "../../lib/link-manifest.json";

export async function getStaticPaths() {
   const docs = await getAllDocs();
   return docs
      .filter((d) => d.id !== "index")
      .map((entry) => ({ params: { path: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const meta = loadContentMeta();
const sectionSlug = entry.id.split("/")[0];
const breadcrumb = await buildBreadcrumb(entry.id);
const { Content, headings } = await render(entry);

// Section / folder landing
const children = data.isSection ? await getDocChildren(entry.id) : [];
const folderCounts = data.isSection ? getFolderLeafCounts() : {};
const leafCount = data.isSection
   ? (folderCounts[entry.id] ?? children.filter((c) => !c.data.isSection).length)
   : 0;

// Leaf document
const kindLabel = KIND_LABELS[data.kind];
const { prev, next } = data.isSection ? {} : await getDocNeighbours(entry.id);
const linkedFrom = data.isSection ? [] : await getLinkedFrom(docUrl(entry), linkManifest);
const repoUrl = meta.site.repoUrl;
const sourceHref = repoUrl ? `${repoUrl}/blob/main/${data.sourcePath}` : undefined;
const kindWord = kindLabel.toLowerCase();
---

{
   data.isSection ? (
      <BaseLayout title={data.title} description={data.deck || data.description || undefined}>
         <DocsShell currentSectionSlug={sectionSlug} currentId={entry.id}>
            <div
               class="landing"
               data-pagefind-body
               data-pagefind-meta={`kind:${sectionLabel(meta, sectionSlug) ?? "Docs"}, meta:${leafCount} docs`}
            >
               <div data-pagefind-ignore>
                  <Breadcrumb items={breadcrumb} />
               </div>
               <div class="vhead">
                  <p class="eyebrow">{sectionLabel(meta, sectionSlug)}</p>
                  <h1>{data.title}</h1>
                  {data.deck && <p class="sec-sub">{data.deck}</p>}
               </div>
               {headings.length > 0 || data.wordCount > 0 ? (
                  <div class="prose landing-prose">
                     <Content />
                  </div>
               ) : null}
               <div data-pagefind-ignore>
                  <div class="sec-hd vsec-hd">
                     <h2>In this folder</h2>
                     <span class="count">
                        {leafCount} {leafCount === 1 ? "doc" : "docs"}
                     </span>
                  </div>
                  {children.length === 0 ? (
                     <p class="sec-sub">Nothing published here yet.</p>
                  ) : (
                     <DocList docs={children} folderCounts={folderCounts} />
                  )}
               </div>
            </div>
         </DocsShell>
      </BaseLayout>
   ) : (
      <BaseLayout
         title={data.title}
         description={data.deck || data.description || undefined}
         ogType="article"
         ogImage={`/og/docs--${entry.id.replace(/\//g, "--")}.png`}
      >
         <DocsShell currentSectionSlug={sectionSlug} currentId={entry.id}>
            <Article
               contained={false}
               crumbs={breadcrumb}
               kind={kindLabel}
               kickerExtra={[{ text: `${data.readingMinutes} min read` }]}
               title={data.title}
               deck={data.deck || data.description || undefined}
               meta={[
                  { label: "Status", status: data.status },
                  { label: "Version", text: data.version ?? "1.0.0" },
                  { label: "Created", date: data.created },
                  { label: "Updated", date: data.updated ?? data.created },
                  { label: "License", text: data.license ?? "CC BY-NC 4.0" },
               ]}
               headings={headings}
               tags={data.tags}
               band={{ motif: KIND_TO_MOTIF[data.kind], seed: data.docId }}
               searchMeta={STATUS_LABELS[data.status]}
               neighbours={{
                  label: `Nearby ${kindWord}s`,
                  prev: prev && { href: docUrl(prev), title: prev.data.title, label: "Previous" },
                  next: next && { href: docUrl(next), title: next.data.title, label: "Next" },
               }}
            >
               <Content />
               <Fragment slot="after">
                  {linkedFrom.length > 0 && (
                     <section class="art-extra" aria-labelledby="linked-from">
                        <h2 class="panel-label" id="linked-from">
                           Linked from
                        </h2>
                        <ul>
                           {linkedFrom.map((l) => (
                              <li>
                                 <a href={l.href}>{l.title}</a>
                              </li>
                           ))}
                        </ul>
                     </section>
                  )}
                  {sourceHref && (
                     <p class="art-source">
                        <span class="panel-label">Source</span>
                        <a href={sourceHref}>{data.sourcePath}</a>
                     </p>
                  )}
               </Fragment>
            </Article>
         </DocsShell>
      </BaseLayout>
   )
}
