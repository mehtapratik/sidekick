---
interface Crumb {
   label: string;
   href?: string;
}

interface Props {
   items: Crumb[];
}

const { items } = Astro.props;
const last = items.length - 1;
---

<nav class="crumbs" aria-label="Breadcrumb">
   <ol>
      {
         items.map((item, i) => (
            <li>
               {i === last ? (
                  <span aria-current="page">{item.label}</span>
               ) : item.href ? (
                  <a href={item.href}>{item.label}</a>
               ) : (
                  <span>{item.label}</span>
               )}
            </li>
         ))
      }
   </ol>
</nav>
