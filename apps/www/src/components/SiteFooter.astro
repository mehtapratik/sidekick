---
import Icon from "./Icon.astro";
import { type ContentMeta } from "../lib/site.ts";

interface Props {
   contentMeta: ContentMeta;
}

const { contentMeta } = Astro.props;
const repoUrl = contentMeta.site.repoUrl;
const author = contentMeta.defaults.author ?? "Pratik Mehta";
const license = contentMeta.defaults.license ?? "CC BY-NC 4.0";
const year = new Date().getFullYear();
---

<footer class="ftr">
   <div class="wrap ftr-in">
      <span>© {year} {author} · {license}</span>
      <nav aria-label="Footer">
         <a href="/rss.xml">RSS<Icon name="rss" /></a>
         {
            repoUrl && (
               <a href={repoUrl}>
                  Source on GitHub
                  <Icon name="arrow-up-right" />
               </a>
            )
         }
         <a href="#top">Back to top<Icon name="arrow-up" /></a>
      </nav>
   </div>
</footer>
