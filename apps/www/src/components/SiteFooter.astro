---
import { type ContentMeta } from "../lib/site.ts";

interface Props {
   contentMeta: ContentMeta;
}

const { contentMeta } = Astro.props;
const repoUrl = contentMeta.site.repoUrl;
const year = new Date().getFullYear();
---

<footer class="site-footer">
   <div class="site-footer__inner">
      <span>© {year} Pratik Mehta · CC BY-NC 4.0</span>
      <div class="links">
         {
            repoUrl && (
               <a href={repoUrl} target="_blank" rel="noopener noreferrer">
                  GitHub
               </a>
            )
         }
         <a href="/rss.xml">RSS</a>
      </div>
   </div>
</footer>
