---
import type { ContentMeta } from "../lib/site.ts";
interface Props {
   title: string;
   description?: string;
   ogType?: "website" | "article";
   ogImage?: string | null;
   contentMeta: ContentMeta;
}

const {
   title,
   description: pageDescription,
   ogType = "website",
   contentMeta,
   ogImage = null,
} = Astro.props;
const siteTitle = contentMeta.site.title ?? "ARKIVE";
// Many vault docs have no deck/description; fall back to the site intro so
// every page still carries a meta description. (Deliberately not a body
// excerpt: a doc body can mention redacted wikilink targets.)
const description = pageDescription || contentMeta.site.intro || undefined;
const siteUrl = contentMeta.site.url ?? "https://arkive.blog";
const pageTitle = title === siteTitle ? siteTitle : `${title} — ${siteTitle}`;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Resolve OG image: prop > default /og-image.png
const resolvedOgImage = ogImage
   ? new URL(ogImage, siteUrl).href
   : `${siteUrl}/og-image.png`;
---

<title>{pageTitle}</title>
<link rel="canonical" href={canonical} />
{description && <meta name="description" content={description} />}

<!-- Favicon -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={resolvedOgImage} />

<link
   rel="alternate"
   type="application/rss+xml"
   title={siteTitle}
   href="/rss.xml"
/>
<meta name="generator" content={Astro.generator} />
