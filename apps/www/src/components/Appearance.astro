---
// Light / dark theme toggle. The page follows the OS until the reader picks
// otherwise; a pick that lands back on the OS scheme clears the stored
// choice, so "follow my device" is always one click away. The stored choice
// lives in localStorage["arkive-theme"]; BaseLayout's no-flash script
// applies it. Both icons render and CSS shows the one for the theme a click
// switches *to*, so the button is right before any script runs.
import Icon from "./Icon.astro";
---

<button class="tool theme-toggle" type="button" aria-label="Switch theme" data-theme-toggle>
   <span class="theme-icon theme-icon--to-dark"><Icon name="moon" /></span>
   <span class="theme-icon theme-icon--to-light"><Icon name="sun" /></span>
   <span class="tool-label">Theme</span>
</button>

<script>
   const KEY = "arkive-theme";
   const COLORS = { light: "#ffffff", dark: "#0b0b0b" };
   const root = document.documentElement;
   const osDark = matchMedia("(prefers-color-scheme: dark)");
   const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

   type Theme = "light" | "dark";

   const effective = (): Theme =>
      root.dataset.theme === "light" || root.dataset.theme === "dark"
         ? root.dataset.theme
         : osDark.matches
           ? "dark"
           : "light";

   function label() {
      const to = effective() === "dark" ? "light" : "dark";
      button?.setAttribute("aria-label", `Switch to ${to} theme`);
   }

   function apply(choice: Theme | "system") {
      if (choice === "system") delete root.dataset.theme;
      else root.dataset.theme = choice;
      // Explicit choice pins both theme-color metas; System restores the
      // per-scheme values.
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
         const scheme = m.media.includes("dark") ? "dark" : "light";
         m.content = COLORS[choice === "system" ? scheme : choice];
      });
      label();
   }

   button?.addEventListener("click", () => {
      const next: Theme = effective() === "dark" ? "light" : "dark";
      const matchesOs = next === (osDark.matches ? "dark" : "light");
      try {
         if (matchesOs) localStorage.removeItem(KEY);
         else localStorage.setItem(KEY, next);
      } catch {}
      apply(matchesOs ? "system" : next);
   });

   osDark.addEventListener("change", label);
   label();
</script>
