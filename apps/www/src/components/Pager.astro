---
import type { Entry } from "../lib/entries";

interface Props {
   prev?: Entry;
   next?: Entry;
   total: number;
}
const { prev, next, total } = Astro.props;
---

<nav class="pager-nav" aria-label="Previous and next entries">
   <div class="pager">
      <p class="older">
         <span class="label"
            ><span class="icon" aria-hidden="true"></span>Previous</span
         >
         <span class="slot" data-slot="prev" data-key="←">
            {
               prev ? (
                  <a rel="prev" href={prev.url} aria-keyshortcuts="ArrowLeft">
                     {prev.title}
                  </a>
               ) : (
                  <span class="muted">None. This is the earliest entry.</span>
               )
            }
         </span>
      </p>
      <p class="newer">
         <span class="label"
            >Next<span class="icon" aria-hidden="true"></span></span
         >
         <span class="slot" data-slot="next" data-key="→">
            {
               next ? (
                  <a rel="next" href={next.url} aria-keyshortcuts="ArrowRight">
                     {next.title}
                  </a>
               ) : (
                  <span class="muted">None. This is the latest entry.</span>
               )
            }
         </span>
      </p>
   </div>
   <p class="scope">
      <span data-scope
         >Previous and next follow all {total.toLocaleString("en-US")} entries, by
         as-of date.</span
      >
      <button type="button" data-clear hidden>Clear filter</button>
   </p>
</nav>
