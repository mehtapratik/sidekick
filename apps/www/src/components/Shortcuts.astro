---
// Keyboard shortcuts: 1/2/3 follow the numbered nav, ←/→ follow an
// article's prev/next links, ? opens this panel. Targets are read from the
// DOM ([data-shortcut], [data-nav]) so URLs stay defined in one place. The
// panel reuses the search drop-down styling and holds the WCAG 2.1.4
// switch that turns every single-key shortcut off.
import { NAV_ITEMS } from "../lib/site.ts";

const rows = [
   ...NAV_ITEMS.map(({ label, num }) => ({ keys: [String(Number(num))], label: `Go to ${label}` })),
   { keys: ["←", "→"], label: "Previous / next article" },
   { keys: ["/"], label: "Search" },
   { keys: ["?"], label: "Show this panel" },
];
---

<dialog class="search keys" id="keys-dialog" aria-labelledby="keys-label" data-keys-dialog>
   <div class="wrap panel-in">
      <div class="panel-row">
         <p class="panel-label" id="keys-label">Keyboard shortcuts</p>
         <button class="close" type="button" data-keys-close>
            <span>Close</span>
            <kbd>Esc</kbd>
         </button>
      </div>
      <dl class="keys-list">
         {
            rows.map((r) => (
               <div>
                  <dt>
                     {r.keys.map((k) => (
                        <kbd>{k}</kbd>
                     ))}
                  </dt>
                  <dd>{r.label}</dd>
               </div>
            ))
         }
      </dl>
      <label class="keys-toggle">
         <input type="checkbox" data-keys-enabled />
         Enable single-key shortcuts
      </label>
   </div>
</dialog>

<script>
   import { isEditing, setShortcutsEnabled, shortcutsEnabled } from "../lib/shortcuts.ts";

   const dialog = document.querySelector<HTMLDialogElement>("[data-keys-dialog]")!;
   const toggle = dialog.querySelector<HTMLInputElement>("[data-keys-enabled]")!;

   function open() {
      if (dialog.open) return;
      document.dispatchEvent(new CustomEvent("arkive:panel", { detail: "keys" }));
      const header = document.querySelector("[data-site-header]");
      const top = header ? header.getBoundingClientRect().bottom : 0;
      dialog.style.setProperty("--search-top", `${Math.max(0, top)}px`);
      toggle.checked = shortcutsEnabled();
      dialog.showModal();
   }

   dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
   });
   dialog.querySelector("[data-keys-close]")!.addEventListener("click", () => dialog.close());
   toggle.addEventListener("change", () => setShortcutsEnabled(toggle.checked));
   document.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-open-keys]")) open();
   });
   document.addEventListener("arkive:panel", (e) => {
      if ((e as CustomEvent).detail !== "keys" && dialog.open) dialog.close();
   });

   // Arrow keys also scroll wide code blocks and tables. Those keep them only
   // when they actually overflow sideways, so a narrow code block doesn't
   // swallow prev/next. (Tree <summary> rows don't use arrow keys natively.)
   function ownsArrowKeys(target: HTMLElement): boolean {
      const scroller = target.closest<HTMLElement>(".table-scroll, figure.code pre, pre");
      return !!scroller && scroller.scrollWidth > scroller.clientWidth;
   }

   document.addEventListener("keydown", (e) => {
      if (!shortcutsEnabled() || isEditing(e) || document.querySelector("dialog[open]")) return;

      if (e.key === "?") {
         e.preventDefault();
         open();
         return;
      }

      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
         if (e.shiftKey || ownsArrowKeys(e.target as HTMLElement)) return;
         const link = document.querySelector<HTMLAnchorElement>(
            `a[data-nav="${e.key === "ArrowLeft" ? "prev" : "next"}"]`,
         );
         if (link) {
            e.preventDefault();
            link.click();
         }
         return;
      }

      const nav = document.querySelector<HTMLAnchorElement>(`a[data-shortcut="${e.key}"]`);
      if (nav && !e.shiftKey) {
         e.preventDefault();
         nav.click();
      }
   });
</script>
