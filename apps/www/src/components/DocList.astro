---
// Vault listing rows: title · status (or, for a folder, its document
// count) · chevron. The whole row is the link.
import Icon from "./Icon.astro";
import StatusIndicator from "./StatusIndicator.astro";
import { docUrl, type Doc } from "../lib/entries.ts";

interface Props {
   docs: Doc[];
   /** Leaf counts for folder landings, keyed by doc id. */
   folderCounts?: Record<string, number>;
}

const { docs, folderCounts = {} } = Astro.props;
---

<ul class="dl">
   {
      docs.map((d) => (
         <li>
            <a class="dl-a" href={docUrl(d)}>
               <span class="dl-t">{d.data.title}</span>
               {d.data.isSection ? (
                  <span class="status">
                     Folder · {folderCounts[d.id] ?? 0} {folderCounts[d.id] === 1 ? "doc" : "docs"}
                  </span>
               ) : (
                  <StatusIndicator status={d.data.status} />
               )}
               <span class="dl-go" aria-hidden="true">
                  <Icon name="chevron-right" />
               </span>
            </a>
         </li>
      ))
   }
</ul>
