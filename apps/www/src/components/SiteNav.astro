---
import { NAV_ITEMS } from "../lib/site.ts";

const path = Astro.url.pathname;
---

<nav class="nav" aria-label="Primary">
   {
      NAV_ITEMS.map(({ href, label, num }) => (
         <a class="nav-a" href={href} aria-current={path.startsWith(href) ? "page" : undefined}>
            <span class="nav-num" aria-hidden="true">
               {num}
            </span>
            {label}
         </a>
      ))
   }
</nav>
