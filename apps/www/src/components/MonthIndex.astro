---
// Chronological listing grouped by month: month heading · day · title · kind.
// Used by /index/ and the /tags/<tag>/ pages.
import type { ChronoEntry } from "../lib/entries.ts";
import { KIND_LABELS, WRITING_TYPE_LABELS } from "../lib/site.ts";
import { formatDay, formatMonth, formatDateYmd } from "../lib/reading.ts";

interface Props {
   items: ChronoEntry[];
}

const { items } = Astro.props;
const months: { label: string; items: ChronoEntry[] }[] = [];
for (const item of items) {
   const label = formatMonth(item.created);
   if (months.at(-1)?.label !== label) months.push({ label, items: [] });
   months.at(-1)!.items.push(item);
}
const kindOf = (item: ChronoEntry) =>
   item.kind === "writing"
      ? WRITING_TYPE_LABELS[item.entry.data.type]
      : KIND_LABELS[item.entry.data.kind];
---

<div class="idx">
   {
      months.map((m) => (
         <section class="idx-month" aria-label={m.label}>
            <h2 class="idx-m">{m.label}</h2>
            <ul class="idx-list">
               {m.items.map((item) => (
                  <li>
                     <a class="idx-a" href={item.url}>
                        <time class="idx-d" datetime={formatDateYmd(item.created)}>
                           {formatDay(item.created)}
                        </time>
                        <span class="idx-t">{item.title}</span>
                        <span class="idx-k">{kindOf(item)}</span>
                     </a>
                  </li>
               ))}
            </ul>
         </section>
      ))
   }
</div>
