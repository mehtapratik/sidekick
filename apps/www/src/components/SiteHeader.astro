---
import SiteNav from "./SiteNav.astro";
import Appearance from "./Appearance.astro";
import Icon from "./Icon.astro";
import { type ContentMeta } from "../lib/site.ts";

interface Props {
   contentMeta: ContentMeta;
}

const { contentMeta } = Astro.props;
const host = new URL(contentMeta.site.url ?? "https://arkive.blog").host;
const [name, ...rest] = host.split(".");
---

<header class="hdr" data-site-header>
   <div class="wrap hdr-in">
      <a class="brand" href="/" aria-label={`${host}, home`}>
         <span class="brand-mark" aria-hidden="true">§</span>
         <span aria-hidden="true">{name}<span class="brand-dot">.</span>{rest.join(".")}</span>
      </a>

      <SiteNav />

      <div class="tools">
         <button
            class="tool"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="search-dialog"
            aria-label="Search the archive"
            data-open-search
         >
            <Icon name="search" />
            <span class="tool-label">Search</span>
            <kbd aria-hidden="true">/</kbd>
         </button>
         <Appearance />
      </div>
   </div>

</header>
