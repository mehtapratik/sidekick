---
// Pagefind search as a drop-down panel below the header. A native <dialog>
// opened with showModal() gives the focus trap, Esc-to-close and focus
// restoration for free. Results come from the Pagefind JS API (not the
// prebuilt UI) so they render as the design's kind · title · meta rows.
// Pages opt in to the index with data-pagefind-body and describe
// themselves via data-pagefind-meta="kind:…, meta:…".
import Icon from "./Icon.astro";
import { getChronological } from "../lib/entries.ts";
import { KIND_LABELS, STATUS_LABELS, WRITING_TYPE_LABELS } from "../lib/site.ts";
import { formatDate } from "../lib/reading.ts";

const recent = (await getChronological()).slice(0, 4).map((item) =>
   item.kind === "writing"
      ? {
           url: item.url,
           title: item.title,
           kind: WRITING_TYPE_LABELS[item.entry.data.type],
           meta: formatDate(item.created),
        }
      : {
           url: item.url,
           title: item.title,
           kind: KIND_LABELS[item.entry.data.kind],
           meta: STATUS_LABELS[item.entry.data.status],
        },
);
---

<dialog class="search" id="search-dialog" aria-labelledby="search-label" data-search-dialog>
   <div class="wrap panel-in">
      <div class="panel-row">
         <p class="panel-label" id="search-label">Search writings &amp; the vault</p>
         <button class="close" type="button" data-search-close>
            <span>Close</span>
            <kbd>Esc</kbd>
         </button>
      </div>
      <div class="search-field">
         <Icon name="search" />
         <label class="sr-only" for="search-input">Search</label>
         <input
            id="search-input"
            type="search"
            placeholder="Try “turborepo” or “sidekick”"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="search-status"
            data-search-input
         />
      </div>
      <p class="panel-label results-label" id="search-status" aria-live="polite" data-search-status>
         Recent
      </p>
      <ul class="results" data-search-results>
         {
            recent.map((r) => (
               <li>
                  <a class="res" href={r.url}>
                     <span class="res-kind">{r.kind}</span>
                     <span class="res-title">{r.title}</span>
                     <span class="res-meta">{r.meta}</span>
                  </a>
               </li>
            ))
         }
      </ul>
      <p class="empty" hidden data-search-empty>
         Nothing matches “<span data-search-query></span>”. Try a broader word, or browse the
         <a href="/docs/">vault</a>.
      </p>
      <div class="hint" aria-hidden="true">
         <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
         <span><kbd>↵</kbd> to open</span>
         <span><kbd>Esc</kbd> to close</span>
      </div>
   </div>
</dialog>

<script>
   type PagefindResult = {
      url: string;
      meta: { title?: string; kind?: string; meta?: string };
   };
   type Pagefind = {
      debouncedSearch: (
         q: string,
         opts?: object,
         ms?: number,
      ) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
   };

   const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]")!;
   const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
   const list = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
   const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;
   const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
   const recentMarkup = list.innerHTML;
   const trigger = document.querySelector<HTMLElement>("[data-open-search]");
   let pagefind: Pagefind | null | undefined;
   let returnFocus: HTMLElement | null = null;

   async function loadPagefind(): Promise<Pagefind | null> {
      if (pagefind !== undefined) return pagefind;
      try {
         // Pagefind only exists after a build, outside Vite's module graph.
         // A plain import() gets wrapped in Vite's preload helper, which
         // doesn't survive in an inlined script — so hide it from the bundler.
         const importer = new Function("u", "return import(u)") as (u: string) => Promise<unknown>;
         pagefind = (await importer("/pagefind/pagefind.js")) as Pagefind;
      } catch {
         pagefind = null;
      }
      return pagefind;
   }

   function row(r: PagefindResult): HTMLLIElement {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.className = "res";
      a.href = r.url;
      for (const [cls, text] of [
         ["res-kind", r.meta.kind ?? "Page"],
         ["res-title", r.meta.title ?? r.url],
         ["res-meta", r.meta.meta ?? ""],
      ]) {
         const span = document.createElement("span");
         span.className = cls;
         span.textContent = text;
         a.append(span);
      }
      li.append(a);
      return li;
   }

   async function runSearch() {
      const q = input.value.trim();
      if (!q) {
         list.innerHTML = recentMarkup;
         status.textContent = "Recent";
         empty.hidden = true;
         return;
      }
      const pf = await loadPagefind();
      if (!pf) {
         list.replaceChildren();
         status.textContent = "Search is available after a production build";
         empty.hidden = true;
         return;
      }
      const search = await pf.debouncedSearch(q, {}, 150);
      if (search === null) return; // superseded by a newer keystroke
      const data = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      if (input.value.trim() !== q) return;
      list.replaceChildren(...data.map(row));
      const n = search.results.length;
      status.textContent = `${n} ${n === 1 ? "result" : "results"}`;
      empty.hidden = n > 0;
      dialog.querySelector("[data-search-query]")!.textContent = q;
   }

   function open() {
      if (dialog.open) return;
      document.dispatchEvent(new CustomEvent("arkive:panel", { detail: "search" }));
      const header = document.querySelector("[data-site-header]");
      const top = header ? header.getBoundingClientRect().bottom : 0;
      dialog.style.setProperty("--search-top", `${Math.max(0, top)}px`);
      const active = document.activeElement as HTMLElement | null;
      returnFocus = active && active !== document.body ? active : trigger;
      dialog.showModal();
      trigger?.setAttribute("aria-expanded", "true");
      input.focus();
      input.select();
      loadPagefind();
   }

   dialog.addEventListener("close", () => {
      trigger?.setAttribute("aria-expanded", "false");
      returnFocus?.focus();
   });

   // Click on the backdrop (outside the panel content) closes.
   dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
   });
   dialog.querySelector("[data-search-close]")!.addEventListener("click", () => dialog.close());
   input.addEventListener("input", runSearch);

   // ↑/↓ move between the input and result links; ↵ on the input opens the
   // first result (↵ on a focused link is native).
   dialog.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
         e.preventDefault();
         dialog.close();
         return;
      }
      const links = Array.from(list.querySelectorAll<HTMLAnchorElement>("a.res"));
      const items: HTMLElement[] = [input, ...links];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
         if (i === -1) return;
         e.preventDefault();
         const next = e.key === "ArrowDown" ? Math.min(i + 1, items.length - 1) : Math.max(i - 1, 0);
         items[next].focus();
      } else if (e.key === "Enter" && document.activeElement === input && links[0]) {
         e.preventDefault();
         links[0].click();
      }
   });

   document.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-open-search]")) open();
   });

   document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey || dialog.open) return;
      const t = e.target as HTMLElement;
      if (t.closest("input, textarea, select, [contenteditable]")) return;
      e.preventDefault();
      open();
   });

   document.addEventListener("arkive:panel", (e) => {
      if ((e as CustomEvent).detail !== "search" && dialog.open) dialog.close();
   });
</script>
