---
// Procedural art as a short band at the top of an essay or document.
// Both palettes are rendered; CSS shows the one matching the current
// appearance (explicit data-theme, or the OS preference for System). The
// SVG crops to fill the band rather than letterboxing.
import { renderHeroSVG, HERO_ART_PALETTES } from "../lib/hero-art.js";
import type { HeroArtType } from "../lib/hero-art.js";

interface Props {
   motif: string;
   seed: string;
   class?: string;
}

const { motif, seed, class: className } = Astro.props;
const crop = (svg: string) => svg.replace("<svg ", '<svg preserveAspectRatio="xMidYMid slice" ');
const light = crop(renderHeroSVG(motif as HeroArtType, seed, 640, HERO_ART_PALETTES.light));
const dark = crop(renderHeroSVG(motif as HeroArtType, seed, 640, HERO_ART_PALETTES.dark));
---

<figure class={`hero-art${className ? ` ${className}` : ""}`} aria-hidden="true" data-pagefind-ignore>
   <div class="hero-art__theme hero-art__theme--light" set:html={light} />
   <div class="hero-art__theme hero-art__theme--dark" set:html={dark} />
</figure>
