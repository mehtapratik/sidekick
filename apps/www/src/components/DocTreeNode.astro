---
// One node of the vault tree. A leaf is a link with its status shape; a
// folder (a landing page with children) is a nested <details>, open when
// it contains the current page, whose first item links to the landing.
import StatusIndicator from "./StatusIndicator.astro";
import { STATUS_LABELS, type DocStatus } from "../lib/site.ts";

export interface TreeNode {
   id: string;
   title: string;
   kind: string;
   status: string;
   isSection: boolean;
   children: TreeNode[];
}

interface Props {
   node: TreeNode;
   currentId?: string;
}

const { node, currentId } = Astro.props;
const href = `/docs/${node.id}/`;
const status = node.status as DocStatus;

function contains(n: TreeNode, id?: string): boolean {
   return !!id && (n.id === id || n.children.some((c) => contains(c, id)));
}
function countLeaves(n: TreeNode): number {
   return n.children.reduce((sum, c) => sum + (c.isSection ? countLeaves(c) : 1), 0);
}
---

{
   node.children.length === 0 ? (
      <li data-tree-item>
         <a class="tree-a" href={href} aria-current={node.id === currentId ? "page" : undefined}>
            <StatusIndicator status={status} shapeOnly />
            <span data-tree-title>{node.title}</span>
            <span class="sr-only">, {STATUS_LABELS[status]}</span>
         </a>
      </li>
   ) : (
      <li data-tree-item data-tree-folder>
         <details class="tree-sub" open={contains(node, currentId)}>
            <summary class="tree-sub-sum">
               <span data-tree-title>{node.title}</span>
               <span class="tree-count">{countLeaves(node)}</span>
            </summary>
            <ul class="tree-list">
               <li data-tree-item>
                  <a
                     class="tree-a tree-a--landing"
                     href={href}
                     aria-current={node.id === currentId ? "page" : undefined}
                  >
                     <span data-tree-title>Overview</span>
                     <span class="sr-only">: {node.title}</span>
                  </a>
               </li>
               {node.children.map((child) => (
                  <Astro.self node={child} currentId={currentId} />
               ))}
            </ul>
         </details>
      </li>
   )
}
