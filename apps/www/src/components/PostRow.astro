---
// One list row: date · (kicker, title, deck, tags) · arrow. The title is
// the row's only link, stretched over the whole row with ::after.
import Icon from "./Icon.astro";
import { formatDate, formatDateYmd } from "../lib/reading.ts";
import { tagSlug } from "../lib/entries.ts";

interface Props {
   href: string;
   title: string;
   kind: string;
   minutes?: number;
   deck?: string;
   date: Date;
   tags?: string[];
   /** Heading level of the title within the page outline. */
   level?: 2 | 3;
}

const { href, title, kind, minutes, deck, date, tags = [], level = 2 } = Astro.props;
const Heading = `h${level}`;
---

<li class="row" data-tags={tags.map(tagSlug).join(" ")}>
   <div class="row-date"><time datetime={formatDateYmd(date)}>{formatDate(date)}</time></div>
   <div>
      <p class="kicker">
         <span class="kind">{kind}</span>
         {
            minutes && (
               <>
                  <span class="dot" aria-hidden="true">
                     ·
                  </span>
                  <span>{minutes} min read</span>
               </>
            )
         }
      </p>
      <Heading class="row-title"><a href={href}>{title}</a></Heading>
      {deck && <p class="row-deck">{deck}</p>}
      {
         tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
               {tags.map((t) => (
                  <li>#{t}</li>
               ))}
            </ul>
         )
      }
   </div>
   <span class="row-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
</li>
