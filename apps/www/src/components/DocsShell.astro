---
// Docs layout: sticky vault tree beside the content on desktop; on mobile
// the tree collapses into one "Browse the vault" disclosure above it.
import DocTree from "./DocTree.astro";
import Icon from "./Icon.astro";
import manifest from "../lib/ingest-manifest.json";

interface Props {
   currentSectionSlug?: string;
   currentId?: string;
}

const { currentSectionSlug, currentId } = Astro.props;
const total = `${manifest.counts.documents} docs`;
---

<div class="wrap docs">
   <aside class="tree" aria-label="Vault navigation">
      <div class="tree-h">
         <p class="panel-label">Vault</p>
         <span class="count">{total}</span>
      </div>
      <DocTree idPrefix="tree" currentSectionSlug={currentSectionSlug} currentId={currentId} />
   </aside>

   <div class="docs-main">
      <details class="tree-m">
         <summary>
            <Icon name="list" size={18} />
            Browse the vault
            <span class="tree-count">{total}</span>
         </summary>
         <DocTree idPrefix="tree-m" currentSectionSlug={currentSectionSlug} currentId={currentId} />
      </details>
      <slot />
   </div>
</div>
