{
   "name": "sidekick",
   "version": "0.0.0",
   "private": true,
   "license": "MIT",
   "type": "module",
   "scripts": {
      "build": "turbo build",
      "check:content": "node scripts/check-content.mjs",
      "db:generate": "turbo db:generate",
      "db:migrate": "turbo db:migrate",
      "dev": "turbo dev",
      "format": "prettier --write .",
      "lint": "turbo lint",
      "lint:styles": "stylelint \"apps/**/*.module.css\" \"packages/**/*.module.css\"",
      "ops:entitlements:grant": "pnpm -C packages/ops entitlements:grant",
      "prepare": "husky",
      "prettier:check": "prettier --check .",
      "test": "turbo test",
      "test:integration": "turbo test:integration",
      "typecheck": "turbo typecheck"
   },
   "lint-staged": {
      "*": "prettier --write --ignore-unknown"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@next/eslint-plugin-next": "16.4.3",
      "@sidekick/eslint-plugin-sidekick": "workspace:*",
      "dotenv-cli": "^11.1.0",
      "eslint": "^10.13.0",
      "eslint-import-resolver-typescript": "^4.4.5",
      "eslint-plugin-boundaries": "^7.4.0",
      "eslint-plugin-import-x": "^4.17.1",
      "eslint-plugin-react-hooks": "^7.1.1",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "prettier": "^3.9.10",
      "prettier-plugin-astro": "^0.14.1",
      "stylelint": "^17.16.0",
      "turbo": "^2.11.10",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.72.1"
   },
   "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
   "engines": {
      "node": "24.x"
   }
}
