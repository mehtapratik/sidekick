{
   "name": "sidekick",
   "private": true,
   "license": "MIT",
   "version": "0.0.0",
   "type": "module",
   "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
   "engines": {
      "node": "24.x"
   },
   "scripts": {
      "build": "turbo build",
      "dev": "turbo dev",
      "lint": "turbo lint",
      "typecheck": "turbo typecheck",
      "format": "prettier --write .",
      "prettier:check": "prettier --check .",
      "lint:styles": "stylelint \"apps/**/*.module.css\" \"packages/**/*.module.css\"",
      "db:generate": "turbo db:generate",
      "db:migrate": "turbo db:migrate",
      "ops:entitlements:grant": "pnpm -C packages/ops entitlements:grant",
      "test": "turbo test",
      "test:integration": "turbo test:integration",
      "docs:setup": "node scripts/setup-docs.mjs",
      "postinstall": "node scripts/setup-docs.mjs",
      "prepare": "husky"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@next/eslint-plugin-next": "16.4.2",
      "@sidekick/eslint-plugin-sidekick": "workspace:*",
      "dotenv-cli": "^11.0.0",
      "eslint": "^10.13.0",
      "eslint-import-resolver-typescript": "^4.4.5",
      "eslint-plugin-boundaries": "^7.2.1",
      "eslint-plugin-import-x": "^4.17.1",
      "eslint-plugin-react-hooks": "^7.1.1",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "prettier": "^3.9.10",
      "stylelint": "^17.16.0",
      "turbo": "^2.11.10",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.72.0"
   },
   "lint-staged": {
      "*": "prettier --write --ignore-unknown"
   }
}
