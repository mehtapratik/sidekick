{
   "name": "sidekick",
   "version": "0.0.0",
   "private": true,
   "license": "MIT",
   "type": "module",
   "scripts": {
      "build": "turbo build",
      "check:content": "node scripts/check-content.mjs",
      "db:generate": "dotenv -e .env.local -- turbo db:generate",
      "db:migrate": "dotenv -e .env.local -- turbo db:migrate",
      "dev": "turbo dev",
      "format": "prettier --write .",
      "lint": "turbo lint",
      "lint:styles": "stylelint \"apps/**/*.module.css\" \"packages/**/*.module.css\"",
      "ops:entitlements:grant": "pnpm -C packages/ops entitlements:grant",
      "prepare": "husky",
      "prettier:check": "prettier --check .",
      "test": "turbo test",
      "test:integration": "scripts/test-db/with-test-db.sh turbo test:integration",
      "typecheck": "turbo typecheck"
   },
   "lint-staged": {
      "*": "prettier --write --ignore-unknown"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
      "@next/eslint-plugin-next": "16.4.6",
      "@sidekick/eslint-plugin-sidekick": "workspace:*",
      "dotenv-cli": "^11.1.0",
      "eslint": "^10.14.0",
      "eslint-import-resolver-typescript": "^4.4.5",
      "eslint-plugin-astro": "^3.2.1",
      "eslint-plugin-boundaries": "^7.4.3",
      "eslint-plugin-import-x": "^4.18.1",
      "eslint-plugin-react-hooks": "^7.1.1",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "prettier": "^3.10.1",
      "prettier-plugin-astro": "^1.1.2",
      "prettier-plugin-packagejson": "^3.1.0",
      "stylelint": "^17.16.0",
      "turbo": "^2.11.11",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.72.2"
   },
   "packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3",
   "engines": {
      "node": "24.x"
   }
}
