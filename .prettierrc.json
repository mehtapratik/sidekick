{
   "semi": true,
   "singleQuote": true,
   "tabWidth": 3,
   "trailingComma": "all",
   "arrowParens": "always",
   "quoteProps": "consistent",
   "plugins": [
      "prettier-plugin-astro",
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-packagejson"
   ],
   "overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }],
   "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@sidekick/",
      "",
      "^[.]"
   ]
}
