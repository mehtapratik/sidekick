{
   "semi": true,
   "singleQuote": true,
   "tabWidth": 3,
   "trailingComma": "all",
   "arrowParens": "always",
   "quoteProps": "consistent",
   "plugins": ["prettier-plugin-astro", "@ianvs/prettier-plugin-sort-imports"],
   "overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }]
}
